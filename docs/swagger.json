        },
        "docs.EventRequest": {
            "type": "object",
            "required": [
                "end_time",
                "start_time",
                "title"
            ],
            "properties": {
                "description": {
                    "type": "string",
                    "example": "Weekly planning"
                },
                "end_time": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2026-10-01T10:00:00+07:00"
                },
                "start_time": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2026-10-01T09:00:00+07:00"
                },
                "title": {
                    "type": "string",
                    "example": "Team meeting"
                }
            }
        },
        "docs.HealthResponse": {
